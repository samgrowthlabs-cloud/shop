{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoplab",
  "main": "cloudflare-dashboard/worker.js",
  "compatibility_date": "2026-07-15",
  "keep_vars": true,
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://shoplab.com.br,https://admin.shoplab.com.br,http://127.0.0.1:5500,http://localhost:5500",
    "MERCADOLIVRE_CLIENT_ID": "6261942816253841",
    "MERCADOPAGO_CHECKOUT_PUBLIC_KEY": "TEST-23181122-eb38-4602-8743-6802537add27",
    "MERCADOPAGO_CHECKOUT_SANDBOX": "true",
    "MERCADOPAGO_PUBLIC_KEY": "TEST-23181122-eb38-4602-8743-6802537add27",
    "PREMIUM_MONTHLY_PRICE_CENTS": "300",
    "REWARD_EMAIL_FROM": "SHOPLAB Recompensas <recompensas@auth.shoplab.com.br>",
    "AWS_SES_REGION": "us-east-2",
    "AWS_SES_FROM_TRANSACTIONAL": "ShopLab <no-reply@shoplab.com.br>",
    "AWS_SES_FROM_NEWSLETTER": "ShopLab Notícias <noticias@shoplab.com.br>",
    "AWS_SES_REPLY_TO_NEWSLETTER": "suporte@shoplab.com.br",
    "AWS_SES_CONFIGURATION_SET": "my-first-configuration-set",
    "EMAIL_ENV": "production",
    "PUBLIC_SITE_URL": "https://shoplab.com.br",
    "PUBLIC_MEDIA_URL": "https://shoplab.bidjorysamuel.workers.dev"
  },
  "queues": {
    "producers": [{ "binding": "NEWSLETTER_QUEUE", "queue": "shoplab-newsletter-devteste" }],
    "consumers": [{ "queue": "shoplab-newsletter-devteste", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 8, "dead_letter_queue": "shoplab-newsletter-devteste-dlq", "max_concurrency": 1, "retry_delay": 30 }]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "routes": [
    { "pattern": "admin.shoplab.com.br", "custom_domain": true },
    { "pattern": "shoplab.com.br/admin*", "zone_name": "shoplab.com.br" },
    { "pattern": "noticias.shoplab.com.br", "custom_domain": true },
    { "pattern": "shoplab.com.br/noticias*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/api/v1/news*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/api/v1/user/newsletter*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/api/v1/email/events/ses*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/news-sitemap.xml", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/politica-de-privacidade*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/politica-de-cookies*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/termos-de-uso*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/news.js*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/shoplab-ads-public.js*", "zone_name": "shoplab.com.br" },
{ "pattern": "shoplab.com.br/assets/css/news.css*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/css/shoplab-loader.css*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/css/main.css*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/app.js*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/app-20260827-v5.js*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/public-media-20260827-v5.js*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/public-media.js*", "zone_name": "shoplab.com.br" },
    { "pattern": "shoplab.com.br/assets/js/policy-defaults.js*", "zone_name": "shoplab.com.br" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/admin*", "/", "/login", "/login.html", "/painel", "/usuarios", "/produtos", "/produto-formulario", "/categorias", "/colecoes", "/caracteristicas", "/marcas", "/parceiros", "/promocoes", "/noticias", "/noticias/*", "/newsletter", "/banners", "/destaques", "/anuncios", "/shoplab-ads", "/premium", "/ia", "/equipe", "/arquivos", "/call", "/midia", "/conversor", "/gravador", "/mixer", "/aparencia", "/politicas", "/categoria", "/categoria.html", "/colecao", "/colecao.html", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoplab",
      "database_id": "711189cc-43c1-468c-9681-5f489f070b54"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TEAM_CHAT", "class_name": "TeamChatRoom" },
      { "name": "TEAM_CALL", "class_name": "TeamCallRoom" },
      { "name": "NEWS_ANALYTICS", "class_name": "NewsAnalyticsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1-team-realtime", "new_sqlite_classes": ["TeamChatRoom"] },
    { "tag": "v2-team-call", "new_sqlite_classes": ["TeamCallRoom"] },
    { "tag": "v3-news-analytics", "new_sqlite_classes": ["NewsAnalyticsDO"] }
  ]
}
